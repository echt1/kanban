rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(boardData) {
      return request.auth != null && (
        request.auth.uid in boardData.members ||
        request.auth.token.email in boardData.memberEmails
      );
    }

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    match /boards/{boardId} {
      allow read: if isMember(resource.data);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if isMember(resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /lists/{listId} {
        allow read, write: if isMember(boardData(boardId));
      }

      match /cards/{cardId} {
        allow read, write: if isMember(boardData(boardId));
      }
    }
  }
}
