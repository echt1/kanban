rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(boardData) {
      return request.auth != null && (
        request.auth.uid in boardData.members ||
        request.auth.token.email in boardData.memberEmails
      );
    }

    function isPublic(boardData) {
      return boardData.public == true;
    }

    // NEU: Board ist für die Discord-Aktivität geöffnet, in der man gerade ist (nur lesen)
    function inActivity(boardData) {
      return request.auth != null && boardData.activityId == request.auth.token.activityId;
    }

    function canRead(boardData) {
      return isPublic(boardData) || isMember(boardData) || inActivity(boardData);
    }

    function isOwner(boardData) {
      return request.auth != null && request.auth.uid == boardData.ownerId;
    }

    // Nicht-Owner dürfen alles am Board bearbeiten außer Mitglieder und Aktivitäts-Freigabe
    function membershipUnchanged() {
      return request.resource.data.members == resource.data.members &&
             request.resource.data.memberEmails == resource.data.memberEmails &&
             request.resource.data.get('memberProfiles', {}) == resource.data.get('memberProfiles', {}) &&
             request.resource.data.get('activityId', '') == resource.data.get('activityId', '');
    }

    // Erlaubt genau EINEN Sonderfall: die eigene UID zu members hinzufügen
    function selfJoinOnly() {
      return request.resource.data.memberEmails == resource.data.memberEmails &&
             request.resource.data.get('memberProfiles', {}) == resource.data.get('memberProfiles', {}) &&
             request.resource.data.get('activityId', '') == resource.data.get('activityId', '') &&
             request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
             !(request.auth.uid in resource.data.members);
    }

    function boardData(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data;
    }

    match /boards/{boardId} {
      allow read: if canRead(resource.data);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if isMember(resource.data) &&
        (isOwner(resource.data) || membershipUnchanged() || selfJoinOnly());
      allow delete: if isOwner(resource.data);

      match /lists/{listId} {
        allow read: if canRead(boardData(boardId));
        allow write: if isMember(boardData(boardId));
      }

      match /cards/{cardId} {
        allow read: if canRead(boardData(boardId));
        allow write: if isMember(boardData(boardId));
      }

      match /presence/{uid} {
        allow read: if isMember(boardData(boardId));
        allow write: if request.auth != null && request.auth.uid == uid && isMember(boardData(boardId));
      }
    }

    match /tables/{tableId} {
      allow read: if isMember(resource.data);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if isMember(resource.data) &&
        (isOwner(resource.data) || membershipUnchanged() || selfJoinOnly());
      allow delete: if isOwner(resource.data);
    }

    match /userSettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
